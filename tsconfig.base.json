{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@shecancode/block-engine": ["packages/block-engine/src/index.ts"],
      "@shecancode/lesson-engine": ["packages/lesson-engine/src/index.ts"],
      "@shecancode/shared-types": ["packages/shared-types/src/index.ts"],
      "@shecancode/ui": ["packages/ui/src/index.tsx"],
      "@shecancode/voice-parser": ["packages/voice-parser/src/index.ts"]
    }
  }
}

