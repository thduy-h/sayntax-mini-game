{
  "name": "shecancode-voice",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @shecancode/web",
    "build": "npm run build --workspace @shecancode/web",
    "lint": "npm run lint --workspace @shecancode/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --import tsx apps/web/lib/operations/operations.test.ts && node --import tsx scripts/lesson-seed-mapping.test.ts",
    "check:staging-env": "node scripts/staging-config-check.mjs",
    "check:production-env": "node scripts/staging-config-check.mjs production",
    "smoke": "node scripts/release-smoke.mjs",
    "smoke:asr": "node scripts/asr-smoke.mjs",
    "load:smoke": "node scripts/load-smoke.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.9 <12"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
