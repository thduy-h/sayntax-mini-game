{
  "name": "shecancode-voice",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @shecancode/web",
    "build": "npm run build --workspace @shecancode/web",
    "lint": "npm run lint --workspace @shecancode/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}

